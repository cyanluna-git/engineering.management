# Edwards Project Operation Board - Environment Variables
#
# Copy this file to .env and fill in your values.
# For server deployment, use: python deploy_env_remote.py --profile server

# Port Configuration
DB_PORT=5434
BACKEND_PORT=8004
FRONTEND_PORT=3004
PORTAL_PORT=3000
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443

# Docker Build Configuration
# CPU Architecture for ODBC driver (auto, amd64, arm64)
# Leave as 'auto' for automatic detection, or set manually if needed
DOCKER_BUILD_ARCH=auto

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=edwards

# Database URL
# Docker: 컨테이너 내부에서는 'db' 호스트명 사용
# DATABASE_URL=postgresql://postgres:password@db:5432/edwards
# Local: 로컬 개발 시 localhost 사용 (포트 변경됨)
DATABASE_URL=postgresql://postgres:password@localhost:5434/edwards

# Database Reset (set to true to reset DB on startup)
RESET_DB=false

# Backend API
APP_NAME=Edwards Project Operation Board
SECRET_KEY=edwards-secret-key-change-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=true
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:5173

# Portal Gateway Handoff
# For HS256, signing and verify keys use the same secret value.
PORTAL_HANDOFF_SIGNING_KEY=
PORTAL_HANDOFF_VERIFY_KEY=
PORTAL_HANDOFF_VERIFY_KEY_PREV=
PORTAL_HANDOFF_TOKEN_EXPIRE_SECONDS=120
GATEWAY_MODE_EOB=direct
GATEWAY_MODE_OQC=direct
GATEWAY_MODE_JARVIS=direct

# Frontend
# Keep the same API base in dev/prod. In dev, Vite proxies /api to the backend.
VITE_API_URL=/api
VITE_APP_BASE=/
# Used by Vite dev server only (see frontend/vite.config.ts)
VITE_DEV_PROXY_TARGET=http://localhost:8004
# Portal service URLs (used at build time)
VITE_PORTAL_URL=https://pcas-portal.atlascopco.group
VITE_OQC_URL=https://oqc.atlascopco.group
VITE_JARVIS_URL=https://sw-portal.atlascopco.group
VITE_TESTRIG_URL=https://testrig.10.182.252.32.sslip.io

# Portal service links and optional edge-proxy defaults
PORTAL_DOMAIN=pcas-portal.atlascopco.group
EOB_DOMAIN=eob.10.182.252.32.sslip.io
OQC_DOMAIN=oqc.atlascopco.group
JARVIS_DOMAIN=sw-portal.atlascopco.group
NEXT_PUBLIC_EOB_URL=https://eob.10.182.252.32.sslip.io
NEXT_PUBLIC_OQC_URL=https://oqc.atlascopco.group
NEXT_PUBLIC_JARVIS_URL=https://sw-portal.atlascopco.group
NEXT_PUBLIC_TESTRIG_URL=http://dashboard.10-182-252-5.sslip.io
EOB_INTERNAL_API_URL=http://backend:8004
OQC_UPSTREAM=https://oqc.atlascopco.group/
JARVIS_UPSTREAM=https://sw-portal.atlascopco.group/

# AI Provider Configuration
# Options: "groq", "gemini", "pcas"
AI_PROVIDER=groq

OLLAMA_MODEL=phi3
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Groq (fast inference with Llama models)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30

# Gemini (Google Gemini models)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30

# PCAS (Atlas Copco AI Brains Bot - internal)
# Requires VPN for local development
PCAS_LLM_KEY=your-pcas-token
PCAS_LLM_BASE_URL=https://groupapp.atlascopco.com/ai-brains/api
PCAS_LLM_VERIFY_SSL=true
PCAS_LLM_MODEL=gpt-5
PCAS_LLM_TIMEOUT=30
# Default UPN for health check and when user context is missing (required by PCAS API)
PCAS_LLM_DEFAULT_UPN=your-email@edwardsvacuum.com

# Portal OIDC Gateway (primary sign-in owner)
PORTAL_OIDC_ENABLED=false
PORTAL_SESSION_SECRET=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_TENANT_ID=
PORTAL_OIDC_AUTHORITY=
PORTAL_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
PORTAL_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
PORTAL_OIDC_SCOPES=openid,profile,email,offline_access,User.Read

# Backend OIDC / MSAL Configuration (legacy direct login + calendar consent)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_AUTHORITY=
OIDC_REDIRECT_URI=http://localhost:8004/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3004/login
OIDC_SCOPES=openid,profile,email,offline_access,User.Read
OIDC_ALLOWED_EXTRA_SCOPES=Calendars.Read
