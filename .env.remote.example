# Edwards Project Operation Board - Server Environment Variables
#
# RECOMMENDED: Auto-generate from .env using the server profile:
#
#   python deploy_env_remote.py --profile server
#   python deploy_env_remote.py --profile server --domain custom.domain.com
#   python deploy_env_remote.py --profile server --scp user@host:/path/.env.remote
#
# This reads your local .env, applies server transforms (DEBUG=false,
# LOG_LEVEL=info, OIDC URLs with https, CORS with server domain), and
# removes dev-only keys (DATABASE_URL, VITE_DEV_PROXY_TARGET).
#
# MANUAL METHOD (legacy):
#   Copy this file to .env.remote and fill in values marked CHANGE_ME.
#   python deploy_env_remote.py --from-env .env --set POSTGRES_PASSWORD=...

DB_PORT=5434
BACKEND_PORT=8004
FRONTEND_PORT=3004
PORTAL_PORT=3000
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

DOCKER_BUILD_ARCH=auto

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=edwards

# DATABASE_URL is composed inside docker-compose.yml from POSTGRES_* vars
# DATABASE_URL=postgresql://postgres:<password>@db:5432/edwards

RESET_DB=false

APP_NAME=Edwards Project Operation Board
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false
LOG_LEVEL=info

# Portal Gateway Handoff
# For HS256, signing and verify keys use the same secret value.
PORTAL_HANDOFF_SIGNING_KEY=CHANGE_ME_SHARED_HANDOFF_SECRET
PORTAL_HANDOFF_VERIFY_KEY=CHANGE_ME_SHARED_HANDOFF_SECRET
PORTAL_HANDOFF_VERIFY_KEY_PREV=
PORTAL_HANDOFF_TOKEN_EXPIRE_SECONDS=120
GATEWAY_MODE_EOB=direct
GATEWAY_MODE_OQC=direct
GATEWAY_MODE_JARVIS=direct

CORS_ORIGINS=http://localhost:3000,http://localhost:3004,https://pcas-portal.atlascopco.group,https://eob.atlascopco.group,https://oqc.atlascopco.group,https://sw-portal.atlascopco.group

VITE_APP_BASE=/
VITE_API_URL=/api

# Portal OIDC Gateway (primary sign-in owner)
PORTAL_OIDC_ENABLED=false
PORTAL_SESSION_SECRET=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_TENANT_ID=
PORTAL_OIDC_AUTHORITY=
PORTAL_OIDC_REDIRECT_URI=https://pcas-portal.atlascopco.group/auth/callback
PORTAL_OIDC_POST_LOGOUT_REDIRECT_URI=https://pcas-portal.atlascopco.group/
PORTAL_OIDC_SCOPES=openid,profile,email,offline_access,User.Read

# Backend OIDC / MSAL configuration (legacy direct login + calendar consent)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_AUTHORITY=
OIDC_REDIRECT_URI=https://your-domain.example.com/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://your-domain.example.com/login
OIDC_SCOPES=openid,profile,email,offline_access,User.Read
OIDC_ALLOWED_EXTRA_SCOPES=Calendars.Read
VITE_OQC_URL=https://oqc.atlascopco.group
VITE_JARVIS_URL=https://sw-portal.atlascopco.group

PORTAL_DOMAIN=pcas-portal.atlascopco.group
EOB_DOMAIN=eob.atlascopco.group
OQC_DOMAIN=oqc.atlascopco.group
JARVIS_DOMAIN=sw-portal.atlascopco.group
NEXT_PUBLIC_EOB_URL=https://eob.atlascopco.group
NEXT_PUBLIC_OQC_URL=https://oqc.atlascopco.group
NEXT_PUBLIC_JARVIS_URL=https://sw-portal.atlascopco.group
OQC_UPSTREAM=https://oqc.atlascopco.group/
JARVIS_UPSTREAM=https://sw-portal.atlascopco.group/
